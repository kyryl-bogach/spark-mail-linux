#!/usr/bin/env bash
# Run the Spark CLI (spark.exe) inside the same Wine prefix as Spark Desktop.
# The desktop app must run and CLI access must be enabled under
# Settings > AI Agents. Put this script's directory on PATH to give AI
# agents a native-looking `spark` command.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
root=$(cd "$(dirname "$self")/.." && pwd)
config=${SPARK_CONFIG:-$root/spark.local.env}
if [ -f "$config" ]; then
  # shellcheck source=/dev/null
  source "$config"
fi
export SPARK_ROOT=$root
app=$(readlink -f "${SPARK_APP:-$root/app}")
export SPARK_EXE=$app/resources/app.asar.unpacked/node_modules/@readdle/sparkcore-win/bin/Release/SparkCore.bundle/spark.exe
export SPARK_NOTIFY=0
exec "$root/run-spark.sh" "$@"
