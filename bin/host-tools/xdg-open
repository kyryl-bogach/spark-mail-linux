#!/usr/bin/env bash
# Open web links through the host portal and local files through the host
# xdg-open. Preserve other xdg-open requests.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
case ${1:-} in
  [hH][tT][tT][pP]://*|[hH][tT][tT][pP][sS]://*)
    exec /usr/bin/python3 "$here/open-host-url.py" "$@"
    ;;
  [fF][iI][lL][eE]://*|/*)
    exec /usr/bin/python3 "$here/open-host-file.py" "$@"
    ;;
  *)
    exec /usr/bin/xdg-open "$@"
    ;;
esac
